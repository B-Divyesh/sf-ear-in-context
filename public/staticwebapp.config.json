{
  "routes": [
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/sw.js", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/favicon.svg", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "route": "/apple-touch-icon.jpg", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "route": "/manifest.webmanifest", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "route": "/robots.txt", "headers": { "Cache-Control": "public, max-age=3600" } },
    { "route": "/sitemap.xml", "headers": { "Cache-Control": "public, max-age=3600" } },
    { "route": "/", "rewrite": "/index.html" },
    { "route": "/index.html", "rewrite": "/index.html" },
    { "route": "/demo", "rewrite": "/index.html" },
    { "route": "/privacy", "rewrite": "/index.html" },
    { "route": "/terms", "rewrite": "/index.html" },
    { "route": "/404", "statusCode": 404 },
    { "route": "/*", "statusCode": 404 }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/index.html" }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
    "Permissions-Policy": "microphone=(self)",
    "Content-Security-Policy": "default-src 'self'; connect-src 'self' https://api.sociobot.in; img-src 'self'; media-src 'self' blob:; style-src 'self'; script-src 'self'; worker-src 'self';"
  },
  "mimeTypes": { ".webmanifest": "application/manifest+json" }
}
